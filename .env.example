# CDN Server Configuration
PORT=3200

# Admin Authentication (for Panel access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
DB_NAME=faserCDN

# S3-Compatible Cache Storage
CACHE_URL=https://your-s3-endpoint.com
CACHE_USERNAME=your-access-key
CACHE_PASSWORD=your-secret-key

# Debug mode (optional)
DEBUG=0
